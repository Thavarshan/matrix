{
    "name": "jerome/matrix",
    "description": "Event-driven asynchronous helpers and concurrency control for ReactPHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jerome Thayananthajothy",
            "email": "tjthavarshan@gmail.com"
        }
    ],
    "homepage": "https://thavarshan.com",
    "support": {
        "issues": "https://github.com/Thavarshan/matrix/issues",
        "source": "https://github.com/Thavarshan/matrix"
    },
    "require": {
        "php": "^8.3",
        "react/event-loop": "^1.6",
        "react/promise": "^3.3"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Matrix\\": "src/Matrix/"
        },
        "files": [
            "src/Matrix/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --level=max src tests",
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
